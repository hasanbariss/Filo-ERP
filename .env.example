# Filo-ERP Environment Variables
# Bu dosyayı kopyalayıp .env.local olarak kaydedin ve kendi değerlerinizi girin
# Bu dosya git'te takip edilir (güvenli şablon)
# .env.local git'te takip EDİLMEZ (gitignore'da)

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Vercel Dashboard'da bu değerleri Environment Variables olarak ekleyin:
# Settings -> Environment Variables -> Add New

# GPS bakım eşitlemesi: yalnızca sunucuda tutulur, tarayıcıya aktarılmaz.
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key
CRON_SECRET=server_only_random_secret
INFOMOBIL_BASE_URL=https://mobilws.infomobil.com.tr/mobilws/services
INFOMOBIL_USERNAME=your_infomobil_username
INFOMOBIL_PASSWORD=your_infomobil_password
