{
  "name": "filo-erp",
  "version": "1.0.0",
  "description": "Baris.Flow Drive — Filo yönetimi",
  "main": "main.js",
  "author": "Baris.Flow",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "electron .",
    "build": "echo 'No build step needed'",
    "test:hakedis": "node scripts/test-hakedis-calculations.cjs",
    "test:teklif": "node scripts/test-teklif-management.cjs",
    "ios:prepare": "node scripts/prepare-ios.mjs",
    "ios:add": "npm run ios:prepare && cap add ios",
    "ios:sync": "npm run ios:prepare && cap sync ios",
    "ios:open": "cap open ios",
    "build-win": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.ideol.filoerpm",
    "productName": "Baris.Flow Drive",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "signingHashAlgorithms": null,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "language": "1055"
    },
    "files": [
      "**/*",
      "!node_modules/.cache/**",
      "!dist/**",
      "!test-extract/**",
      "!release/**",
      "!*.md",
      "!*.log",
      "!.gitignore"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "dotenv": "^16.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.0",
    "@supabase/supabase-js": "^2.98.0",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  }
}
